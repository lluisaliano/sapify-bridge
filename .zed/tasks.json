[
  {
    "label": "CMake: RUN",
    "command": "./build/sapify-bridge",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },
  {
    "label": "CMake: configurar (Debug)",
    "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },
  {
    "label": "CMake: compilar (Debug)",
    "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build --parallel",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },
  {
    "label": "CMake: compilar y ejecutar (Debug)",
    "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build --parallel && ./build/sapify-bridge",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },
  {
    "label": "CMake: recompilar (Debug)",
    "command": "cmake -S . -B build -DCMAKE_BUILD_TYPE=Debug && cmake --build build --clean-first --parallel",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },
  {
    "label": "CMake: limpiar (Debug)",
    "command": "cmake --build build --target clean",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "CMake: compilar (Release)",
    "command": "cmake -S . -B build/release -DCMAKE_BUILD_TYPE=Release && cmake --build build/release --parallel",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },
  {
    "label": "CMake: compilar y ejecutar (Release)",
    "command": "cmake -S . -B build/release -DCMAKE_BUILD_TYPE=Release && cmake --build build/release --parallel && ./build/release/sapify-bridge",
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  }
]
